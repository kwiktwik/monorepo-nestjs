# Server Configuration
PORT=3002
NODE_ENV=development

REDIS_URL="redis://localhost:6379"

DATABASE_URL=postgresql://postgres:postgress@localhost:5432/kiranaapps

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Equence SMS API
EQUENCE_USERNAME=your-equence-username
EQUENCE_PASSWORD=your-equence-password
EQUENCE_SENDER_ID=ALRTSN
EQUENCE_TMPL_ID=1707176553065211775

# Razorpay - Multi-app configuration
# Each app needs its own credentials and webhook secret
# App ID format: com.example.app -> COM_EXAMPLE_APP (dots to underscores, uppercase)

# com.paymentalert.app
RAZORPAY_KEY_ID_COM_PAYMENTALERT_APP=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET_COM_PAYMENTALERT_APP=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET_COM_PAYMENTALERT_APP=your-webhook-secret

# com.sharekaro.kirana
RAZORPAY_KEY_ID_COM_SHAREKARO_KIRANA=rzp_live_yyyyyyyy
RAZORPAY_KEY_SECRET_COM_SHAREKARO_KIRANA=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET_COM_SHAREKARO_KIRANA=your-webhook-secret

# Add more apps as needed following the same pattern

# PhonePe Payment Gateway - Multi-app configuration
# =================================================
# Each app needs its own credentials following the pattern:
# App ID format: com.example.app -> COM_EXAMPLE_APP (dots to underscores, uppercase)

# Global default environment (SANDBOX or PRODUCTION) - used if not set per app
PHONEPE_ENV=SANDBOX

# com.paymentalert.app
PHONEPE_CLIENT_ID_COM_PAYMENTALERT_APP=your-sandbox-client-id
PHONEPE_CLIENT_SECRET_COM_PAYMENTALERT_APP=your-sandbox-client-secret
PHONEPE_MERCHANT_ID_COM_PAYMENTALERT_APP=PGTESTPAYUAT
PHONEPE_SALT_KEY_COM_PAYMENTALERT_APP=your-sandbox-salt-key
PHONEPE_SALT_INDEX_COM_PAYMENTALERT_APP=1
PHONEPE_CLIENT_VERSION_COM_PAYMENTALERT_APP=1

# com.sharekaro.kirana
PHONEPE_CLIENT_ID_COM_SHAREKARO_KIRANA=your-production-client-id
PHONEPE_CLIENT_SECRET_COM_SHAREKARO_KIRANA=your-production-client-secret
PHONEPE_MERCHANT_ID_COM_SHAREKARO_KIRANA=your-production-merchant-id
PHONEPE_SALT_KEY_COM_SHAREKARO_KIRANA=your-production-salt-key
PHONEPE_SALT_INDEX_COM_SHAREKARO_KIRANA=1
PHONEPE_CLIENT_VERSION_COM_SHAREKARO_KIRANA=1
PHONEPE_ENV_COM_SHAREKARO_KIRANA=PRODUCTION

# R2 Storage (Cloudflare)
# Enable "Public Development URL" on your bucket in Cloudflare dashboard, then copy the exact URL shown
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=uploads
# Public URL for serving uploaded files (CDN or R2 public domain). Path is appended as /{key}
# NOTE: Use cnd.storyowl.app (not cdn) - cdn.storyowl.app does not resolve
# R2_PUBLIC_DOMAIN=https://cnd.storyowl.app
# R2_PROJECT_FOLDER=sharekaro-andriod

# Analytics - Multi-app configuration
# ======================================
# Each app needs its own credentials following the pattern:
# App ID format: com.example.app -> COM_EXAMPLE_APP (dots to underscores, uppercase)

# com.paymentalert.app
FACEBOOK_PIXEL_ID_COM_PAYMENTALERT_APP=your-pixel-id
FACEBOOK_ACCESS_TOKEN_COM_PAYMENTALERT_APP=your-facebook-access-token
FACEBOOK_APP_ID_COM_PAYMENTALERT_APP=your-facebook-app-id
MIXPANEL_TOKEN_COM_PAYMENTALERT_APP=your-mixpanel-token
FIREBASE_MEASUREMENT_ID_COM_PAYMENTALERT_APP=G-XXXXXXXXXX
FIREBASE_API_SECRET_COM_PAYMENTALERT_APP=your-firebase-api-secret

# com.sharekaro.kirana
FACEBOOK_PIXEL_ID_COM_SHAREKARO_KIRANA=your-pixel-id
FACEBOOK_ACCESS_TOKEN_COM_SHAREKARO_KIRANA=your-facebook-access-token
FACEBOOK_APP_ID_COM_SHAREKARO_KIRANA=your-facebook-app-id
MIXPANEL_TOKEN_COM_SHAREKARO_KIRANA=your-mixpanel-token
FIREBASE_MEASUREMENT_ID_COM_SHAREKARO_KIRANA=G-XXXXXXXXXX
FIREBASE_API_SECRET_COM_SHAREKARO_KIRANA=your-firebase-api-secret

# Firebase Admin SDK
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Internal API Configuration
# ==========================================
# Internal API key for service-to-service communication with kirana-fe
# This key must match in both kwiktwik-kirana-be and kirana-fe
INTERNAL_API_KEY=your-secret-internal-api-key-change-this-in-production

# Kirana-FE (Flutter app) backend URL for internal API calls
# Used to check if user exists in legacy Flutter app
KIRANA_FE_BASE_URL=http://localhost:3000

# Migration Safety Configuration
# ==============================
# Set to true to prevent ANY data deletion during migration
# This ensures data is NEVER deleted from kirana-fe (old system)
# Even on migration failure, data in the old system is preserved
MIGRATION_SAFE_MODE=true

# Payment Gateway Module (payment-gateway) — for new users
# =========================================================
# These env vars are for the new unified payment-gateway module.
# They use a DIFFERENT format from the legacy razorpay/phonepe-v2 vars above.
#
# Pattern:  {PROVIDER}_{APP_ID}_{ACCOUNT_ID}_{FIELD}
# APP_ID:   Uppercase with underscores (e.g., COM_PAYMENTALERT_APP)
# ACCOUNT_ID: DEFAULT, MAIN, or PRIMARY marks it as the default account
#
# The service auto-discovers configs by scanning env vars matching these patterns:
#   Razorpay: RAZORPAY_{APP_ID}_{ACCOUNT_ID}_KEY_ID
#   PhonePe:  PHONEPE_{APP_ID}_{ACCOUNT_ID}_CLIENT_ID

# --- Razorpay (payment-gateway) ---
# com.paymentalert.app — default account
RAZORPAY_COM_PAYMENTALERT_APP_DEFAULT_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_COM_PAYMENTALERT_APP_DEFAULT_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_COM_PAYMENTALERT_APP_DEFAULT_WEBHOOK_SECRET=your-webhook-secret

# --- PhonePe (payment-gateway) ---
# com.paymentalert.app — default account
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_CLIENT_ID=your-sandbox-client-id
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_CLIENT_SECRET=your-sandbox-client-secret
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_SALT_KEY=your-sandbox-salt-key
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_SALT_INDEX=1
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_CLIENT_VERSION=1
PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_WEBHOOK_SECRET=your-phonepe-webhook-secret
# PHONEPE_COM_PAYMENTALERT_APP_DEFAULT_CHECKOUT_MODE=API_INTEGRATION  # or STANDARD_CHECKOUT

# --- Feature flags ---
PAYMENT_USE_DB_REPOS=true
PAYMENT_BILLING_SCHEDULER_ENABLED=true
PAYMENT_CIRCUIT_BREAKER_ENABLED=true
PAYMENT_BILLING_DLQ_ENABLED=false
PAYMENT_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-credentials-here

# Circuit Breaker Tuning (optional)
# PAYMENT_CB_FAILURE_THRESHOLD=5
# PAYMENT_CB_SUCCESS_THRESHOLD=3
# PAYMENT_CB_TIMEOUT_MS=30000
# PAYMENT_CB_FAILURE_WINDOW_MS=60000

# Sentry Configuration
# ====================
# Get your DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Environment (e.g., development, staging, production)
SENTRY_ENVIRONMENT=development

# Release version (optional, auto-detected from git if not set)
# SENTRY_RELEASE=1.0.0

# Tracing sample rate (0.0 = disabled, 1.0 = 100% of transactions)
SENTRY_TRACES_SAMPLE_RATE=0.2

# ============================================
# Voice API Configuration
# ============================================

# Default API version (fallback)
VOICE_API_VERSION=v1

# Version 1 (Current) - Gemini Live API
VOICE_PROVIDER_V1=gemini
VOICE_MODEL_V1=gemini-2.0-flash-live-001
GEMINI_API_KEY_V1=your-gemini-api-key-here
GEMINI_VOICE_V1=Puck

# Audio Configuration
VOICE_INPUT_SAMPLE_RATE_V1=24000
VOICE_OUTPUT_SAMPLE_RATE_V1=24000

# Rate Limiting
VOICE_MAX_SESSIONS_PER_USER_V1=5
VOICE_SESSION_TIMEOUT_MS_V1=300000
VOICE_MAX_CHUNK_SIZE_V1=65536
